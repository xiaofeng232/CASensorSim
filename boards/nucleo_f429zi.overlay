/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * CASensorSim app overlay for the NUCLEO-F429ZI (kept buildable next to
 * the FK407M2-ZGT6 target). USART3 (ST-LINK VCP) carries the Fibre
 * protocol (`fibre-uart` alias); console and shell are disabled in
 * prj.conf. Same signal timing as the fk407m2_zgt6 target: TIM8 update
 * events at 100 kHz driving cas_step() (see src/main.cpp).
 */

/ {
	aliases {
		fibre-uart = &usart3;
	};
};

&timers8 {
	status = "okay";
	st,prescaler = <0>;

	counter {
		status = "okay";
	};
};
