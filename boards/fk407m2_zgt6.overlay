/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * CASensorSim app overlay for the FK407M2-ZGT6 (STM32F407ZGT6).
 *
 * USART1 (PA9/PA10, on the SWD/USART1 header) is dedicated to the Fibre
 * protocol (CasIntf telemetry/parameter interface); console and shell are
 * disabled in prj.conf, so no chosen console override is needed here. The
 * `fibre-uart` alias selects the port for src/uart_backend.cpp.
 *
 * Signal generation timing: TIM8 update events at 100 kHz (10 us tick,
 * pin-partition plan); the update interrupt drives cas_step(), the fault
 * injection, the PE0..PE7 output stage and the telemetry mirror (see
 * src/main.cpp).
 */

/ {
	aliases {
		fibre-uart = &usart1;
	};
};

&timers8 {
	status = "okay";
	st,prescaler = <0>;

	counter {
		status = "okay";
	};
};
