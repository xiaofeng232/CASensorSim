/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * CASensorSim app overlay for the FK407M2-ZGT6 (STM32F407ZGT6).
 *
 * The Fibre protocol (CasIntf telemetry/parameter interface) runs over a
 * vendor-specific USB bulk interface on the Type-C connector: the board has
 * no USB-UART bridge, so the native USB device controller is used directly
 * (host side: libusb; the interface carries the Fibre protocol as a raw
 * byte stream). The `fibre-usb` alias below selects the UDC controller for
 * the platform fibre-transport service, which builds the USBD context and
 * the vendor interface (class codes 0xFF/0x01/0x01) on top of it.
 *
 * USART1 is not used by this app and is disabled below, so PA9/PA10 stay
 * free. Console and shell are disabled in prj.conf: the USB interface
 * carries the protocol stream, and the boot banner is visible in the RTT
 * debug build (rtt.conf).
 *
 * Signal generation timing: TIM8 update events at 100 kHz (10 us tick,
 * pin-partition plan); the update interrupt drives cas_step(), the fault
 * injection, the PE0..PE7 output stage and the telemetry mirror (see
 * src/main.cpp).
 */

/ {
	aliases {
		fibre-usb = &zephyr_udc0;
	};
};

&usart1 {
	status = "disabled";
};

&timers8 {
	status = "okay";
	st,prescaler = <0>;

	counter {
		status = "okay";
	};
};
